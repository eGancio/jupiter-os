{
  "mcpServers": {
    "io": {
      "type": "sse",
      "url": "http://127.0.0.1:8100/sse"
    },
    "europa": {
      "type": "sse",
      "url": "http://127.0.0.1:8200/sse"
    },
    "amalthea": {
      "type": "sse",
      "url": "http://127.0.0.1:8300/sse"
    },
    "ganymede": {
      "type": "sse",
      "url": "http://127.0.0.1:8400/sse"
    },
    "callisto": {
      "type": "sse",
      "url": "http://127.0.0.1:8500/sse"
    },
    "metis": {
      "type": "sse",
      "url": "http://127.0.0.1:8600/sse"
    },
    "himalia": {
      "type": "sse",
      "url": "http://127.0.0.1:8700/sse"
    },
    "elara": {
      "type": "sse",
      "url": "http://127.0.0.1:8800/sse"
    },
    "google-ads": {
      "type": "stdio",
      "command": "moons/google-ads/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "moon_google_ads.server"
      ],
      "env": {
        "GOOGLE_ADS_CREDENTIALS": "${GOOGLE_ADS_CREDENTIALS}",
        "GOOGLE_ADS_DEVELOPER_TOKEN": "${GOOGLE_ADS_DEVELOPER_TOKEN}",
        "GOOGLE_ADS_CLIENT_ID": "${GOOGLE_ADS_CLIENT_ID}",
        "GOOGLE_ADS_CLIENT_SECRET": "${GOOGLE_ADS_CLIENT_SECRET}",
        "GOOGLE_ADS_REFRESH_TOKEN": "${GOOGLE_ADS_REFRESH_TOKEN}",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "${GOOGLE_ADS_LOGIN_CUSTOMER_ID}",
        "ADS_MCP_ENABLE_MUTATIONS": "false"
      }
    },
    "meta-ads": {
      "type": "stdio",
      "command": "moons/meta-ads/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "moon_meta_ads.server"
      ],
      "env": {
        "META_ACCESS_TOKEN": "${META_ACCESS_TOKEN}",
        "META_AD_ACCOUNT_ID": "${META_AD_ACCOUNT_ID}"
      }
    },
    "gtd": {
      "type": "http",
      "url": "https://YOUR_JUPITEROS_HOST/mcp-gtd/YOUR_TOKEN/"
    }
  },
  "servers": {
    "io": {
      "command": "moons/target/release/moon-io.exe",
      "args": [],
      "cwd": "moons/io",
      "env": {
        "DATA_DIR": "moons/io/data",
        "IMAP_USERNAME": "YOUR_EMAIL@example.com",
        "IMAP_PASSWORD": "YOUR_PASSWORD",
        "QDRANT_URL": "http://127.0.0.1:6334",
        "QDRANT_STORAGE_DIR": "/ABSOLUTE/PATH/TO/jupiter-os/data/qdrant",
        "MCP_TRANSPORT": "sse",
        "MCP_PORT": "8100"
      }
    },
    "europa": {
      "command": "moons/target/release/moon-europa.exe",
      "args": [],
      "cwd": "moons/europa",
      "env": {
        "DATA_DIR": "moons/europa/data",
        "TELEGRAM_API_ID": "YOUR_API_ID",
        "TELEGRAM_API_HASH": "YOUR_API_HASH",
        "TELEGRAM_FOLDER": "",
        "TELEGRAM_BOT_TOKEN": "",
        "SLACK_BOT_TOKEN": "",
        "TEAMS_CLIENT_ID": "",
        "TEAMS_TENANT_ID": "",
        "TEAMS_REFRESH_TOKEN": "",
        "QDRANT_URL": "http://127.0.0.1:6334",
        "QDRANT_STORAGE_DIR": "/ABSOLUTE/PATH/TO/jupiter-os/data/qdrant",
        "MCP_TRANSPORT": "sse",
        "MCP_PORT": "8200"
      }
    },
    "amalthea": {
      "command": "moons/amalthea/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "moon_amalthea.server"
      ],
      "cwd": "moons/amalthea",
      "env": {
        "AMALTHEA_OUTPUT_DIR": "moons/amalthea/output",
        "MCP_TRANSPORT": "sse",
        "MCP_PORT": "8300"
      }
    },
    "ganymede": {
      "command": "moons/target/release/moon-ganymede.exe",
      "args": [],
      "cwd": "moons/ganymede",
      "env": {
        "GANYMEDE_WIKI_DIR": "../../wiki",
        "DATA_DIR": "../../data",
        "MCP_TRANSPORT": "sse",
        "MCP_PORT": "8400"
      }
    },
    "callisto": {
      "command": "moons/callisto/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "moon_callisto.server"
      ],
      "cwd": "moons/callisto",
      "env": {
        "CALLISTO_OUTPUT_DIR": "moons/callisto/output",
        "MCP_TRANSPORT": "sse",
        "MCP_PORT": "8500"
      }
    },
    "metis": {
      "command": "moons/target/release/moon-metis.exe",
      "args": [],
      "cwd": "moons/metis",
      "env": {
        "DATA_DIR": "moons/metis/data",
        "EMBEDDING_MODEL_DIR": "moons/io/data/model",
        "QDRANT_URL": "http://127.0.0.1:6334",
        "METIS_COLLECTION": "metis_docs",
        "METIS_LLM_BASE_URL": "",
        "METIS_LLM_MODEL": "qwen2.5:7b",
        "METIS_LLM_API_KEY": "",
        "MCP_TRANSPORT": "sse",
        "MCP_PORT": "8600"
      }
    },
    "himalia": {
      "command": "moons/target/release/moon-himalia.exe",
      "args": [],
      "cwd": "moons/himalia",
      "env": {
        "DATA_DIR": "moons/himalia/data",
        "TAVILY_API_KEY": "",
        "OPENAPI_TOKEN": "",
        "OPENAPI_COMPANY_TOKEN": "",
        "OPENAPI_SANDBOX": "0",
        "IMPRESE_MAX_SPEND_EUR": "50",
        "MCP_TRANSPORT": "sse",
        "MCP_PORT": "8700"
      }
    },
    "elara": {
      "command": "moons/target/release/moon-elara.exe",
      "args": [],
      "cwd": "moons/elara",
      "env": {
        "DATA_DIR": "moons/elara/data",
        "REDDIT_CLIENT_ID": "",
        "REDDIT_CLIENT_SECRET": "",
        "REDDIT_USER_AGENT": "jupiteros-elara/0.1",
        "MCP_TRANSPORT": "sse",
        "MCP_PORT": "8800"
      }
    }
  },
  "daemons": {
    "rizzo-pii": {
      "command": "/PATH/A/rizzo-pii/pii-backend",
      "env": { "PII_HOST": "127.0.0.1", "PII_PORT": "5005" },
      "autostart": false
    },
    "localops-llm": {
      "command": "/PATH/A/llama.cpp/build/bin/llama-server",
      "args": [
        "-m",
        "/PATH/A/models/gguf/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf",
        "--alias",
        "qwen3.6-35b-a3b",
        "--host",
        "127.0.0.1",
        "--port",
        "8080",
        "-t",
        "8",
        "--ctx-size",
        "16384",
        "--jinja",
        "--chat-template-kwargs",
        "{\"enable_thinking\":false}",
        "--temp",
        "0",
        "--cache-reuse",
        "256",
        "--parallel",
        "1"
      ],
      "env": {
        "MCP_PORT": "8080"
      }
    }
  }
}