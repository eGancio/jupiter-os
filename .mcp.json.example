{
  "mcpServers": {
    "io": {
      "type": "sse",
      "url": "http://127.0.0.1:8100/sse"
    },
    "europa": {
      "type": "sse",
      "url": "http://127.0.0.1:8200/sse"
    },
    "amalthea": {
      "type": "sse",
      "url": "http://127.0.0.1:8300/sse"
    },
    "ganymede": {
      "type": "sse",
      "url": "http://127.0.0.1:8400/sse"
    },
    "callisto": {
      "type": "sse",
      "url": "http://127.0.0.1:8500/sse"
    },
    "gtd": {
      "type": "http",
      "url": "https://YOUR_JUPITEROS_HOST/mcp-gtd/YOUR_TOKEN/"
    }
  },
  "servers": {
    "io": {
      "command": "target/release/moon-io.exe",
      "args": [],
      "cwd": "moon-io-rs",
      "env": {
        "DATA_DIR": "moon-io-rs/data",
        "IMAP_USERNAME": "YOUR_EMAIL@example.com",
        "IMAP_PASSWORD": "YOUR_PASSWORD",
        "QDRANT_URL": "http://127.0.0.1:6334",
        "QDRANT_STORAGE_DIR": "/ABSOLUTE/PATH/TO/jupiter-os/data/qdrant",
        "MCP_TRANSPORT": "sse",
        "MCP_PORT": "8100"
      }
    },
    "europa": {
      "command": "target/release/moon-europa.exe",
      "args": [],
      "cwd": "moon-europa-rs",
      "env": {
        "DATA_DIR": "moon-europa-rs/data",
        "TELEGRAM_API_ID": "YOUR_API_ID",
        "TELEGRAM_API_HASH": "YOUR_API_HASH",
        "TELEGRAM_FOLDER": "",
        "TELEGRAM_BOT_TOKEN": "",
        "SLACK_BOT_TOKEN": "",
        "TEAMS_CLIENT_ID": "",
        "TEAMS_TENANT_ID": "",
        "TEAMS_REFRESH_TOKEN": "",
        "QDRANT_URL": "http://127.0.0.1:6334",
        "QDRANT_STORAGE_DIR": "/ABSOLUTE/PATH/TO/jupiter-os/data/qdrant",
        "MCP_TRANSPORT": "sse",
        "MCP_PORT": "8200"
      }
    },
    "amalthea": {
      "command": "moon-amalthea/.venv/Scripts/python.exe",
      "args": ["-m", "moon_amalthea.server"],
      "cwd": "moon-amalthea",
      "env": {
        "AMALTHEA_OUTPUT_DIR": "moon-amalthea/output",
        "MCP_TRANSPORT": "sse",
        "MCP_PORT": "8300"
      }
    },
    "ganymede": {
      "command": "target/release/moon-ganymede.exe",
      "args": [],
      "cwd": "moon-ganymede-rs",
      "env": {
        "GANYMEDE_WIKI_DIR": "../wiki",
        "DATA_DIR": "../data",
        "MCP_TRANSPORT": "sse",
        "MCP_PORT": "8400"
      }
    },
    "callisto": {
      "command": "moon-callisto/.venv/Scripts/python.exe",
      "args": ["-m", "moon_callisto.server"],
      "cwd": "moon-callisto",
      "env": {
        "CALLISTO_OUTPUT_DIR": "moon-callisto/output",
        "MCP_TRANSPORT": "sse",
        "MCP_PORT": "8500"
      }
    }
  }
}
